# Copy to .env (it is gitignored) and fill in. Nothing here is baked into the code.

# --- The model: any OpenAI-compatible chat endpoint that supports tool calling.
# Examples:
#   Databricks AI Gateway:  LLM_BASE_URL=https://<workspace>.cloud.databricks.com/ai-gateway/mlflow/v1
#                           LLM_MODEL=system.ai.qwen35-122b-a10b      (or system.ai.gpt-oss-120b)
#   Any other provider:     LLM_BASE_URL=https://<host>/v1   LLM_MODEL=<model name>
LLM_BASE_URL=
LLM_MODEL=
# Either the key itself ...
LLM_API_KEY=
# ... or a file containing it (used when LLM_API_KEY is empty).
# LLM_API_KEY_FILE=.llm_key

# --- The runtime server (workbench-sandbox) and the tenant this service acts for.
SANDBOX_MCP_URL=http://mcp.sandbox.localhost/mcp
# The user whose home every session and sandbox mounts. Keep it fixed: a new id means a new, empty home.
SANDBOX_USER_ID=local-user

# --- Optional
# SANDBOX_AGENT_DATA_DIR=./data     # chat history and sessions (SQLite)
# AGENT_DELEGATE=false              # true: split work into builder and debugger subagents
